{
  "name": "pipaya-marketplace",
  "description": "Community extensions for pipaya",
  "extensions": [
    {
      "id": "guard",
      "kind": "server",
      "name": "Guard",
      "description": "Blocks destructive shell commands (rm -rf /, mkfs, fork bombs) before they run.",
      "version": "0.1.0",
      "author": "dohwi",
      "license": "MIT",
      "homepage": "https://github.com/dohwi/pipaya-extensions/tree/guard-v0.1.0/guard",
      "source": {
        "type": "git",
        "repo": "dohwi/pipaya-extensions",
        "dir": "guard",
        "ref": "guard-v0.1.0",
        "commit": "e6198aabbd8784c4474ab3098db21fe973c8291b"
      }
    },
    {
      "id": "ask-user",
      "kind": "server",
      "name": "Ask User",
      "description": "Lets the agent ask you a question (with options and a recommended choice) and wait for your answer.",
      "version": "0.1.0",
      "author": "dohwi",
      "license": "MIT",
      "homepage": "https://github.com/dohwi/pipaya-extensions/tree/ask-user-v0.1.0/ask-user",
      "source": {
        "type": "git",
        "repo": "dohwi/pipaya-extensions",
        "dir": "ask-user",
        "ref": "ask-user-v0.1.0",
        "commit": "e6198aabbd8784c4474ab3098db21fe973c8291b"
      }
    },
    {
      "id": "quota-monitor",
      "kind": "client",
      "name": "Quota Monitor",
      "description": "Claude · GPT · Antigravity의 upstream 전체 잔량을 navbar 원형 게이지와 팝오버로 표시합니다. Antigravity는 바깥 Gemini · 안쪽 Claude/GPT 잔량입니다.",
      "version": "0.4.1",
      "author": "dohwi",
      "license": "MIT",
      "homepage": "https://github.com/dohwi/pipaya-extensions/tree/quota-monitor-v0.4.1/quota-monitor",
      "source": {
        "type": "url",
        "url": "https://raw.githubusercontent.com/dohwi/pipaya-extensions/quota-monitor-v0.4.1/quota-monitor/dist/quota-monitor.json",
        "sha256": "81f3a672262df96faf6f16a4cd6e453dad7c102e8ecb6524e19b87cb92fe078c"
      }
    },
    {
      "id": "peer-tools",
      "kind": "server",
      "name": "Peer Tools",
      "description": "Lets an agent message (`peer_send`) and read (`peer_read`) the other active chats of the server, by name or group.",
      "version": "0.1.0",
      "author": "dohwi",
      "license": "MIT",
      "homepage": "https://github.com/dohwi/pipaya-extensions/tree/peer-tools-v0.1.0/peer-tools",
      "source": {
        "type": "git",
        "repo": "dohwi/pipaya-extensions",
        "dir": "peer-tools",
        "ref": "peer-tools-v0.1.0",
        "commit": "e6198aabbd8784c4474ab3098db21fe973c8291b"
      }
    },
    {
      "id": "prompt-templates",
      "kind": "server",
      "name": "Prompt Templates",
      "description": "Save a long prompt as a Markdown file and call it with `/prompt:name arguments`.",
      "version": "0.1.0",
      "author": "dohwi",
      "license": "MIT",
      "homepage": "https://github.com/dohwi/pipaya-extensions/tree/prompt-templates-v0.1.0/prompt-templates",
      "source": {
        "type": "git",
        "repo": "dohwi/pipaya-extensions",
        "dir": "prompt-templates",
        "ref": "prompt-templates-v0.1.0",
        "commit": "e6198aabbd8784c4474ab3098db21fe973c8291b"
      }
    },
    {
      "id": "session-retention",
      "kind": "server",
      "name": "Session Retention",
      "description": "Deletes chats that have not been used for a while. Off until you set a number of days.",
      "version": "0.1.0",
      "author": "dohwi",
      "license": "MIT",
      "homepage": "https://github.com/dohwi/pipaya-extensions/tree/session-retention-v0.1.0/session-retention",
      "source": {
        "type": "git",
        "repo": "dohwi/pipaya-extensions",
        "dir": "session-retention",
        "ref": "session-retention-v0.1.0",
        "commit": "e6198aabbd8784c4474ab3098db21fe973c8291b"
      }
    }
  ]
}
